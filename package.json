{
  "name": "@digitaldefiance/node-express-suite",
  "version": "1.0.17",
  "description": "Generic express application and routing library with decorator support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && yarn tsc",
    "test": "yarn jest",
    "test:stream": "yarn jest --outputStyle=stream",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prettier:check": "prettier --check 'src/**/*.{ts,tsx}'",
    "prettier:fix": "prettier --write 'src/**/*.{ts,tsx}'",
    "format": "yarn prettier:fix && yarn lint:fix",
    "prepublishOnly": "yarn build",
    "publish:public": "npm publish --access public"
  },
  "dependencies": {
    "@digitaldefiance/ecies-lib": "1.1.21",
    "@digitaldefiance/i18n-lib": "1.3.10",
    "@digitaldefiance/node-ecies-lib": "1.1.19",
    "@digitaldefiance/suite-core-lib": "1.1.36",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "http": "^0.0.1-security",
    "mongodb": "^6.20.0",
    "mongoose": "^8.18.2"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.3.1",
    "jest": "^29.0.0",
    "jest-util": "^30.0.5",
    "prettier": "^2.6.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.9.2"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "express",
    "decorators",
    "typescript",
    "enum",
    "translation"
  ],
  "author": "Digital Defiance",
  "license": "MIT",
  "packageManager": "yarn@4.10.3"
}
