{
  "name": "@digitaldefiance/node-express-suite",
  "version": "4.23.1",
  "homepage": "https://github.com/Digital-Defiance/node-express-suite",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Digital-Defiance/node-express-suite.git"
  },
  "description": "Generic express application and routing library with decorator support",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./testing": {
      "types": "./src/testing.d.ts",
      "default": "./src/testing.js"
    }
  },
  "scripts": {
    "build": "npx nx build digitaldefiance-node-express-suite",
    "build:prod": "NODE_ENV=production npx nx build digitaldefiance-node-express-suite --configuration=production",
    "build:stream": "npx nx build --outputStyle=stream digitaldefiance-node-express-suite",
    "build:logged": "npx nx build --outputStyle=stream --skip-nx-cache digitaldefiance-node-express-suite 2>&1 | ansifilter -o build.log",
    "test": "npx nx test digitaldefiance-node-express-suite",
    "test:stream": "npx nx test --outputStyle=stream digitaldefiance-node-express-suite",
    "test:logged": "npx nx test --outputStyle=stream digitaldefiance-node-express-suite 2>&1 | ansifilter -o test.log",
    "test:coverage": "npx jest --coverage --testPathPattern=digitaldefiance-node-express-suite --coverageReporters=text",
    "lint": "npx nx lint digitaldefiance-node-express-suite",
    "lint:fix": "npx nx lint digitaldefiance-node-express-suite --fix",
    "prettier:check": "prettier --check 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}'",
    "prettier:fix": "prettier --write 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}'",
    "format": "npx nx format:write --projects=digitaldefiance-node-express-suite",
    "format:check": "npx nx format:check --projects=digitaldefiance-node-express-suite",
    "prepublishOnly": "npx nx build digitaldefiance-node-express-suite",
    "publish:public": "npm publish --access public"
  },
  "dependencies": {
    "@digitaldefiance/branded-interface": "^0.0.5",
    "@digitaldefiance/ecies-lib": "4.20.2",
    "@digitaldefiance/i18n-lib": "4.6.4",
    "@digitaldefiance/node-ecies-lib": "4.20.0",
    "@digitaldefiance/reed-solomon-erasure.wasm": "^1.0.2",
    "@digitaldefiance/suite-core-lib": "4.22.2",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "argon2": "^0.40.1",
    "cors": "^2.8.5",
    "crc": "^4.3.2",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "greenlock-express": "^4.0.3",
    "helmet": "^8.1.0",
    "http": "^0.0.1-security",
    "jsonwebtoken": "^9.0.2",
    "nat-upnp": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@digitaldefiance/express-suite-test-utils": "1.1.1",
    "@types/nat-upnp": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "fast-check": "^4.3.0"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "express",
    "decorators",
    "typescript",
    "enum",
    "translation"
  ],
  "author": "Digital Defiance",
  "license": "MIT",
  "packageManager": "yarn@4.12.0"
}
